msgctxt "#30160"
msgid "Speeds up CD-ROM seeks by the specified factor. May improve loading speeds in some game, at the cost of breaking others."
msgstr "Zrychlí vyhledávání na CD-ROM zadaným násobkem. V některých hrách může zrychlit načítání, ale u jiných může způsobit chyby."

msgctxt "#30161"
msgid "Infinite/Instantaneous"
msgstr "Nekonečná/okamžitá"

